[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:window:allow-hide",
      "core:window:allow-show",
      "core:window:allow-set-focus",
      "opener:default",
      "sql:default",
      "sql:allow-execute",
      "process:default",
      "dialog:default",
      "store:default"
    ]
  },
  {
    "identifier": "updater-desktop",
    "description": "Updater access is only available on desktop runtimes.",
    "windows": ["main"],
    "platforms": ["linux", "macOS", "windows"],
    "permissions": ["updater:default"]
  }
]
